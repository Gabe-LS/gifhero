{
  "name": "gifhero",
  "version": "1.0.0",
  "description": "High-compression GIF encoder. Smaller files than gifski with better visual quality. Browser SDK + Node.js, zero dependencies, WASM-powered.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quality": "vitest run test/quality-gates.test.ts",
    "bench:setup": "bash scripts/bench-setup.sh",
    "bench": "npx tsx test/bench/run.ts",
    "bench:fast": "npx tsx test/bench/run.ts --fast",
    "bench:parallel": "npx tsx test/bench/run.ts --parallel",
    "fixtures": "npx tsx test/fixtures/generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gif",
    "encoder",
    "animation",
    "quantization",
    "imagequant",
    "wasm",
    "browser",
    "chrome-extension",
    "dithering",
    "floyd-steinberg",
    "lzw",
    "video-to-gif"
  ],
  "author": "Gabe-LS",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "canvas": "^3.1.0",
    "gifski-wasm": "^2.2.0",
    "playwright": "^1.61.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "mediabunny": "^1.49.0"
  },
  "peerDependencies": {
    "imagequant": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "imagequant": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabe-LS/gifhero.git"
  },
  "bugs": {
    "url": "https://github.com/Gabe-LS/gifhero/issues"
  },
  "homepage": "https://github.com/Gabe-LS/gifhero"
}
